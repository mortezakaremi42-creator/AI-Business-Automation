  "captions": [
    {
      "start": 0.0,
      "end": 1.73,
      "text": "آخرین قطار رفت؛",
      "chapter": 0
    },
    {
      "start": 1.73,
      "end": 5.82,
      "text": "اما صدایی که از تونل آمد، صدای قطار نبود.",
      "chapter": 0
    },
    {
      "start": 5.82,
      "end": 12.55,
      "text": "آرمان فقط ده ثانیه فرصت داشت تا میان خیابان و تاریکی یکی را انتخاب کند.",
      "chapter": 0
    },
    {
      "start": 12.55,
      "end": 18.35,
      "text": "پشت سرش، آدم‌هایی با چشم‌های سرخ از میان ماشین‌های خاموش می‌دویدند.",
      "chapter": 0
    },
    {
      "start": 18.35,
      "end": 24.43,
      "text": "او از پله‌های ایستگاه پایین پرید و درِ آهنی را با تمام وزنش بست.",
      "chapter": 0
    },
    {
      "start": 24.43,
      "end": 26.59,
      "text": "روز اول آغاز شده بود.",
      "chapter": 0
    },
    {
      "start": 26.59,
      "end": 33.19,
      "text": "تلفنش هیچ آنتنی نداشت و روی تابلوی ایستگاه، همهٔ قطارها لغو شده بودند.",
      "chapter": 0
    },
    {
      "start": 33.19,
      "end": 38.67,
      "text": "آرمان بطری نیمه‌خالی و چراغ‌قوه‌اش را از کوله بیرون آورد.",
      "chapter": 0
    },
    {
      "start": 38.67,
      "end": 41.02,
      "text": "باید چهارده روز دوام می‌آورد؛",
      "chapter": 0
    },
    {
      "start": 41.02,
      "end": 46.77,
      "text": "تا موعد تخلیه‌ای که قبل از قطع برق از رادیوی شهر شنیده بود.",
      "chapter": 0
    },
    {
      "start": 46.77,
      "end": 50.631125,
      "text": "ولی اول باید مطمئن می‌شد زیر زمین، تنهاست.",
      "chapter": 0
    },
    {
      "start": 51.631125,
      "end": 57.011125,
      "text": "روز دوم، آرمان ورودی اصلی را از پشت شیشه بررسی کرد.",
      "chapter": 1
    },
    {
      "start": 57.011125,
      "end": 58.391124999999995,
      "text": "سایه‌ها هنوز آنجا بودند.",
      "chapter": 1
    },
    {
      "start": 58.391124999999995,
      "end": 64.161125,
      "text": "هر ضربه به در، گرد و خاک سقف را پایین می‌ریخت.",
      "chapter": 1
    },
    {
      "start": 64.161125,
      "end": 68.591125,
      "text": "او نیمکت‌ها را روی زمین کشید و پشت ورودی روی هم گذاشت.",
      "chapter": 1
    },
    {
      "start": 68.591125,
      "end": 71.041125,
      "text": "بعد سیم زنگ خطر را جدا کرد؛",
      "chapter": 1
    },
    {
      "start": 71.041125,
      "end": 75.62112499999999,
      "text": "صدای بلند، آن‌ها را بیشتر جمع می‌کرد.",
      "chapter": 1
    },
    {
      "start": 75.62112499999999,
      "end": 79.541125,
      "text": "کنار گیشه، دو بطری آب و یک بسته بیسکویت پیدا شد.",
      "chapter": 1
    },
    {
      "start": 79.541125,
      "end": 85.031125,
      "text": "آرمان روی دیوار، چهارده خط کشید و خط اول را پاک کرد.",
      "chapter": 1
    },
    {
      "start": 85.031125,
      "end": 91.551125,
      "text": "آب را سهمیه‌بندی کرد و گوشه‌ای دور از پله‌ها، با مقوا جای خواب ساخت.",
      "chapter": 1
    },
    {
      "start": 91.551125,
      "end": 94.751125,
      "text": "آن شب چراغ را خاموش نگه داشت.",
      "chapter": 1
    },
    {
      "start": 94.751125,
      "end": 103.57416666666666,
      "text": "درست وقتی فکر کرد مانع کافی است، دستگیرهٔ درِ کارکنان، در انتهای راهرو، آرام تکان خورد.",
      "chapter": 1
    },
    {
      "start": 104.57416666666666,
      "end": 108.02416666666666,
      "text": "روز سوم، سه ضربه از پشت در شنیده شد.",
      "chapter": 2
    },
    {
      "start": 108.02416666666666,
      "end": 108.73416666666665,
      "text": "بعد مکث.",
      "chapter": 2
    },
    {
      "start": 108.73416666666665,
      "end": 110.86416666666666,
      "text": "دوباره سه ضربه.",
      "chapter": 2
    },
    {
      "start": 110.86416666666666,
      "end": 112.91416666666666,
      "text": "این ریتم اتفاقی نبود.",
      "chapter": 2
    },
    {
      "start": 112.91416666666666,
      "end": 116.88416666666666,
      "text": "آرمان لوله‌ای برداشت و پرسید کسی آنجاست؟",
      "chapter": 2
    },
    {
      "start": 116.88416666666666,
      "end": 118.36416666666665,
      "text": "صدای زنی گفت آب می‌خواهم.",
      "chapter": 2
    },
    {
      "start": 118.36416666666665,
      "end": 122.46416666666666,
      "text": "او در را فقط به اندازهٔ زنجیر باز کرد.",
      "chapter": 2
    },
    {
      "start": 122.46416666666666,
      "end": 124.84416666666665,
      "text": "پشت آن، رها نشسته بود؛",
      "chapter": 2
    },
    {
      "start": 124.84416666666665,
      "end": 129.34416666666667,
      "text": "تعمیرکار همین ایستگاه، با یک نوار سفید دور بازویش.",
      "chapter": 2
    },
    {
      "start": 129.34416666666667,
      "end": 134.44416666666666,
      "text": "رها کف دست‌هایش را نشان داد و آرمان راه را باز کرد.",
      "chapter": 2
    },
    {
      "start": 134.44416666666666,
      "end": 140.12416666666667,
      "text": "هیچ نشانی از گازگرفتگی دیده نمی‌شد، اما این، تضمین سلامت نبود.",
      "chapter": 2
    },
    {
      "start": 140.12416666666667,
      "end": 145.01416666666665,
      "text": "رها جرعه‌ای آب خورد و نقشهٔ تاخورده‌ای روی میز گذاشت.",
      "chapter": 2
    },
    {
      "start": 145.01416666666665,
      "end": 151.08416666666665,
      "text": "زیر سکو، اتاق امدادی وجود داشت که به تونل خدماتی وصل می‌شد.",
      "chapter": 2
    },
    {
      "start": 151.08416666666665,
      "end": 155.63483333333332,
      "text": "او گفت اگر ورودی سقوط کند، فقط آن مسیر باقی می‌ماند.",
      "chapter": 2
    },
    {
      "start": 156.63483333333332,
      "end": 160.84483333333333,
      "text": "روز چهارم، آخرین بیسکویت را نصف کردند.",
      "chapter": 3
    },
    {
      "start": 160.84483333333333,
      "end": 162.31483333333333,
      "text": "روز پنجم، آب به ته بطری رسید.",
      "chapter": 3
    },
    {
      "start": 162.31483333333333,
      "end": 167.16483333333332,
      "text": "رها روی نقشه، انبار فروشگاه آن سوی سکو را نشان داد.",
      "chapter": 3
    },
    {
      "start": 167.16483333333332,
      "end": 173.21483333333333,
      "text": "برای رسیدن به آن باید از جلوی راه‌پله عبور می‌کردند.",
      "chapter": 3
    },
    {
      "start": 173.21483333333333,
      "end": 176.57483333333332,
      "text": "آرمان یک قوطی را به گوشهٔ مخالف پرتاب کرد.",
      "chapter": 3
    },
    {
      "start": 176.57483333333332,
      "end": 183.28483333333332,
      "text": "چشم‌های سرخ به سمت صدا چرخیدند و هر دو، خمیده پشت ستون‌ها جلو رفتند.",
      "chapter": 3
    },
    {
      "start": 183.28483333333332,
      "end": 186.3348333333333,
      "text": "درِ انبار گیر کرده بود.",
      "chapter": 3
    },
    {
      "start": 186.3348333333333,
      "end": 191.1448333333333,
      "text": "رها آن را با میله بالا داد و آرمان از شکاف خزید.",
      "chapter": 3
    },
    {
      "start": 191.1448333333333,
      "end": 197.03483333333332,
      "text": "چند کنسرو و آب پیدا شد، اما هنگام بیرون آمدن، یک شیشه از قفسه افتاد.",
      "chapter": 3
    },
    {
      "start": 197.03483333333332,
      "end": 201.6748333333333,
      "text": "صدای شکستن در سالن پیچید.",
      "chapter": 3
    },
    {
      "start": 201.6748333333333,
      "end": 206.1448333333333,
      "text": "حالا موجودات پشت نرده، دقیقاً می‌دانستند غذا کجاست.",
      "chapter": 3
    },
    {
      "start": 206.1448333333333,
      "end": 210.43545833333332,
      "text": "آرمان و رها با کوله‌های سنگین به پناهگاه برگشتند.",
      "chapter": 3
    },
    {
      "start": 211.43545833333332,
      "end": 214.1354583333333,
      "text": "روز ششم، فشار پشت ورودی بیشتر شد.",
      "chapter": 4
    },
    {
      "start": 214.1354583333333,
      "end": 221.1554583333333,
      "text": "پیچ یکی از نیمکت‌ها از جا کنده شد و شکاف باریکی کنار در باز ماند.",
      "chapter": 4
    },
    {
      "start": 221.1554583333333,
      "end": 227.0954583333333,
      "text": "آرمان می‌خواست همهٔ غذاها را همان‌جا نگه دارد، اما رها مخالفت کرد.",
      "chapter": 4
    },
    {
      "start": 227.0954583333333,
      "end": 232.96545833333332,
      "text": "اگر مجبور می‌شدند بدوند، فرصت جمع‌کردن وسایل نداشتند.",
      "chapter": 4
    },
    {
      "start": 232.96545833333332,
      "end": 240.3454583333333,
      "text": "دو سهم کوچک آب و غذا در کوله‌ها گذاشتند و بقیه را کنار راه فرار پنهان کردند.",
      "chapter": 4
    },
    {
      "start": 240.3454583333333,
      "end": 242.9454583333333,
      "text": "بعد، دریچهٔ پایین سکو را امتحان کردند.",
      "chapter": 4
    },
    {
      "start": 242.9454583333333,
      "end": 245.83545833333332,
      "text": "لولای زنگ‌زده تکان نمی‌خورد.",
      "chapter": 4
    },
    {
      "start": 245.83545833333332,
      "end": 253.2254583333333,
      "text": "رها آهسته پیچ‌ها را باز کرد و آرمان نور را روی دست‌های او نگه داشت.",
      "chapter": 4
    },
    {
      "start": 253.2254583333333,
      "end": 258.4954583333333,
      "text": "درست وقتی دریچه آزاد شد، از بالا صدای افتادن مانع آمد.",
      "chapter": 4
    },
    {
      "start": 258.4954583333333,
      "end": 260.5154583333333,
      "text": "هر دو بی‌حرکت ماندند.",
      "chapter": 4
    },
    {
      "start": 260.5154583333333,
      "end": 264.4814583333333,
      "text": "این بار، صدای قدم‌ها از داخل ایستگاه می‌آمد.",
      "chapter": 4
    },
    {
      "start": 265.4814583333333,
      "end": 266.9614583333333,
      "text": "روز هفتم، در شکست.",
      "chapter": 5
    },
    {
      "start": 266.9614583333333,
      "end": 274.33145833333333,
      "text": "اولین موجود از روی نیمکت افتاد و پشت سرش چندین سایه به سالن ریختند.",
      "chapter": 5
    },
    {
      "start": 274.33145833333333,
      "end": 277.6514583333333,
      "text": "آرمان کوله را برداشت و به رها اشاره کرد بدود.",
      "chapter": 5
    },
    {
      "start": 277.6514583333333,
      "end": 279.8514583333333,
      "text": "آن‌ها میان ستون‌ها پیچیدند؛",
      "chapter": 5
    },
    {
      "start": 279.8514583333333,
      "end": 283.6014583333333,
      "text": "دست‌های سیاه فقط چند قدم فاصله داشتند.",
      "chapter": 5
    },
    {
      "start": 283.6014583333333,
      "end": 288.14145833333333,
      "text": "رها به دریچه رسید، اما بند کولهٔ آرمان به نرده گیر کرد.",
      "chapter": 5
    },
    {
      "start": 288.14145833333333,
      "end": 294.0514583333333,
      "text": "او به جای کشیدن، بند را با تیغهٔ کوچک برید.",
      "chapter": 5
    },
    {
      "start": 294.0514583333333,
      "end": 298.83145833333333,
      "text": "کوله روی زمین ماند و آرمان خودش را از شکاف پایین انداخت.",
      "chapter": 5
    },
    {
      "start": 298.83145833333333,
      "end": 300.6914583333333,
      "text": "رها دریچه را کشید.",
      "chapter": 5
    },
    {
      "start": 300.6914583333333,
      "end": 302.9614583333333,
      "text": "دستی میان دو لبه گیر کرد.",
      "chapter": 5
    },
    {
      "start": 302.9614583333333,
      "end": 307.6514583333333,
      "text": "آرمان میله را زیر در اهرم کرد و فشار داد تا دست عقب رفت.",
      "chapter": 5
    },
    {
      "start": 307.6514583333333,
      "end": 309.0314583333333,
      "text": "قفل بسته شد.",
      "chapter": 5
    },
    {
      "start": 309.0314583333333,
      "end": 311.6714583333333,
      "text": "بالای سرشان ضربه‌ها ادامه داشت.",
      "chapter": 5
    },
    {
      "start": 311.6714583333333,
      "end": 317.11104166666667,
      "text": "آن‌ها زنده بودند، اما نصف ذخیره‌شان را از دست داده بودند.",
      "chapter": 5
    },
    {
      "start": 318.11104166666667,
      "end": 323.17104166666667,
      "text": "روز هشتم، راهروی خدماتی به اتاق امداد رسید.",
      "chapter": 6
    },
    {
      "start": 323.17104166666667,
      "end": 325.93104166666666,
      "text": "رها چراغ اضطراری را روشن کرد.",
      "chapter": 6
    },
    {
      "start": 325.93104166666666,
      "end": 333.37104166666666,
      "text": "تخت خالی، جعبهٔ کمک‌های اولیه و رادیویی قدیمی زیر غبار پیدا شد.",
      "chapter": 6
    },
    {
      "start": 333.37104166666666,
      "end": 336.26104166666664,
      "text": "آرمان باتری چراغ‌قوه را امتحان کرد؛",
      "chapter": 6
    },
    {
      "start": 336.26104166666664,
      "end": 338.63104166666665,
      "text": "اندازه‌اش مناسب نبود.",
      "chapter": 6
    },
    {
      "start": 338.63104166666665,
      "end": 347.44104166666665,
      "text": "رها از جعبهٔ برق، باتری پشتیبان را جدا کرد و با دو سیم به رادیو وصل کرد.",
      "chapter": 6
    },
    {
      "start": 347.44104166666665,
      "end": 348.48104166666667,
      "text": "صدای خش‌خش بلند شد.",
      "chapter": 6
    },
    {
      "start": 348.48104166666667,
      "end": 356.24104166666666,
      "text": "میان نویز، جمله‌ای تکرار می‌شد: روز چهاردهم، خروجی شمالی، سکوی تعمیرات.",
      "chapter": 6
    },
    {
      "start": 356.24104166666666,
      "end": 359.61104166666667,
      "text": "آرمان زمان را روی دیوار نوشت.",
      "chapter": 6
    },
    {
      "start": 359.61104166666667,
      "end": 366.19104166666665,
      "text": "پیام، اسم شهر را نمی‌گفت و معلوم نبود کسی هنوز پشت فرستنده باشد.",
      "chapter": 6
    },
    {
      "start": 366.19104166666665,
      "end": 369.36104166666667,
      "text": "رها گفت شاید ضبط‌شده باشد.",
      "chapter": 6
    },
    {
      "start": 369.36104166666667,
      "end": 372.64104166666664,
      "text": "اما برای اولین بار، مقصدی داشتند؛",
      "chapter": 6
    },
    {
      "start": 372.64104166666664,
      "end": 376.578875,
      "text": "مقصدی که می‌توانست نجات باشد، یا تله.",
      "chapter": 6
    },
    {
      "start": 377.578875,
      "end": 381.618875,
      "text": "روز نهم، آرمان زخم دستش را بست؛",
      "chapter": 7
    },
    {
      "start": 381.618875,
      "end": 384.148875,
      "text": "بریدگی از نرده بود، نه از دندان.",
      "chapter": 7
    },
    {
      "start": 384.148875,
      "end": 386.378875,
      "text": "رها پشت در نگهبانی می‌داد.",
      "chapter": 7
    },
    {
      "start": 386.378875,
      "end": 389.91887499999996,
      "text": "روز دهم، دوباره رادیو را روشن کردند.",
      "chapter": 7
    },
    {
      "start": 389.91887499999996,
      "end": 396.248875,
      "text": "پیام این بار عوض شده بود: چراغ قرمز را دنبال نکنید.",
      "chapter": 7
    },
    {
      "start": 396.248875,
      "end": 398.938875,
      "text": "چراغ سفید، مسیر امن است.",
      "chapter": 7
    },
    {
      "start": 398.938875,
      "end": 402.648875,
      "text": "رها روی نقشه، دو شاخهٔ تونل را مشخص کرد.",
      "chapter": 7
    },
    {
      "start": 402.648875,
      "end": 409.72887499999996,
      "text": "شاخهٔ کوتاه‌تر از کنار خط برق می‌گذشت و چراغ قرمز داشت.",
      "chapter": 7
    },
    {
      "start": 409.72887499999996,
      "end": 412.71887499999997,
      "text": "شاخهٔ طولانی به خروجی شمالی می‌رسید.",
      "chapter": 7
    },
    {
      "start": 412.71887499999997,
      "end": 422.59887499999996,
      "text": "آن‌ها مسیر طولانی را انتخاب کردند، چون رسیدن سریع به نشانی اشتباه، نجات نبود.",
      "chapter": 7
    },
    {
      "start": 422.59887499999996,
      "end": 426.29887499999995,
      "text": "آرمان چراغ را با پارچه پوشاند تا نورش دور نرود.",
      "chapter": 7
    },
    {
      "start": 426.29887499999995,
      "end": 433.898875,
      "text": "پیش از حرکت، آخرین سهم غذا را خوردند و بطری را میان خود تقسیم کردند.",
      "chapter": 7
    },
    {
      "start": 434.898875,
      "end": 438.09887499999996,
      "text": "روز یازدهم وارد تونل شدند.",
      "chapter": 8
    },
    {
      "start": 438.09887499999996,
      "end": 443.91887499999996,
      "text": "رها جلو می‌رفت و آرمان هر چند قدم، پشت سر را نگاه می‌کرد.",
      "chapter": 8
    },
    {
      "start": 443.91887499999996,
      "end": 447.008875,
      "text": "روز دوازدهم به دو راهی رسیدند.",
      "chapter": 8
    },
    {
      "start": 447.008875,
      "end": 452.71887499999997,
      "text": "چراغ قرمز روشن بود، اما آن‌ها به سمت علامت سفید پیچیدند.",
      "chapter": 8
    },
    {
      "start": 452.71887499999997,
      "end": 455.058875,
      "text": "آن سوی پیچ، کف تونل شکسته بود.",
      "chapter": 8
    },
    {
      "start": 455.058875,
      "end": 462.558875,
      "text": "رها از روی لولهٔ کناری عبور کرد و دستش را برای آرمان دراز کرد.",
      "chapter": 8
    },
    {
      "start": 462.558875,
      "end": 464.618875,
      "text": "زیر پای او سنگی افتاد.",
      "chapter": 8
    },
    {
      "start": 464.618875,
      "end": 468.508875,
      "text": "صدای برخورد، موجودی را در تاریکی بیدار کرد.",
      "chapter": 8
    },
    {
      "start": 468.508875,
      "end": 473.92887499999995,
      "text": "آن‌ها دویدند و با عبور از درِ ضدحریق، آن را پشت سر بستند.",
      "chapter": 8
    },
    {
      "start": 473.92887499999995,
      "end": 478.55887499999994,
      "text": "روز سیزدهم را کنار همان در، نوبتی بیدار ماندند.",
      "chapter": 8
    },
    {
      "start": 478.55887499999994,
      "end": 482.78887499999996,
      "text": "روی دیوار، علامت خروجی شمالی دیده می‌شد.",
      "chapter": 8
    },
    {
      "start": 482.78887499999996,
      "end": 487.167,
      "text": "حالا فقط یک راه‌پله تا هوای آزاد فاصله داشتند.",
      "chapter": 8
    },
    {
      "start": 488.167,
      "end": 495.48699999999997,
      "text": "روز چهاردهم، آرمان چهارده خط روی نقشه را شمرد و آخرین خط را کشید.",
      "chapter": 9
    },
    {
      "start": 495.48699999999997,
      "end": 497.11699999999996,
      "text": "هر دو از پله‌ها بالا رفتند.",
      "chapter": 9
    },
    {
      "start": 497.11699999999996,
      "end": 501.93699999999995,
      "text": "پشت در، سپیده روی سکوی تعمیرات افتاده بود.",
      "chapter": 9
    },
    {
      "start": 501.93699999999995,
      "end": 506.87699999999995,
      "text": "چراغ سفید کنار یک واگن امدادی چشمک می‌زد.",
      "chapter": 9
    },
    {
      "start": 506.87699999999995,
      "end": 509.577,
      "text": "رها جلو رفت و روی بدنه کوبید.",
      "chapter": 9
    },
    {
      "start": 509.577,
      "end": 511.35699999999997,
      "text": "درِ واگن آرام باز شد.",
      "chapter": 9
    },
    {
      "start": 511.35699999999997,
      "end": 514.0169999999999,
      "text": "یک نفر داخل آن ایستاده بود؛",
      "chapter": 9
    },
    {
      "start": 514.0169999999999,
      "end": 516.9069999999999,
      "text": "بی‌حرکت، با لباس امداد.",
      "chapter": 9
    },
    {
      "start": 516.9069999999999,
      "end": 519.607,
      "text": "آرمان اول به کفش‌هایش نگاه کرد.",
      "chapter": 9
    },
    {
      "start": 519.607,
      "end": 523.2769999999999,
      "text": "بعد به دستی که رادیو را نگه داشته بود.",
      "chapter": 9
    },
    {
      "start": 523.2769999999999,
      "end": 527.457,
      "text": "همان پیام نجات، از دستگاه تکرار می‌شد.",
      "chapter": 9
    },
    {
      "start": 527.457,
      "end": 529.217,
      "text": "مرد سرش را بالا آورد.",
      "chapter": 9
    },
    {
      "start": 529.217,
      "end": 532.1669999999999,
      "text": "زیر کلاه، دو چشم سرخ روشن شد.",
      "chapter": 9
    },
    {
      "start": 532.1669999999999,
      "end": 537.317,
      "text": "رها میان واگن و آرمان گیر افتاده بود.",
      "chapter": 9
    },
    {
      "start": 537.317,
      "end": 539.507,
      "text": "پشت سرشان هم دستگیرهٔ درِ تونل چرخید.",
      "chapter": 9
    },
    {
      "start": 539.507,
      "end": 544.5334583333333,
      "text": "این بار، کدام طرف را باید انتخاب می‌کردند؟",
      "chapter": 9
    }
  ],
  "caption_alignment": "estimated sentence timing snapped to acoustic pauses; not word-for-word forced alignment"
}