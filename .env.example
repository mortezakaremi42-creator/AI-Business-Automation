HOST=0.0.0.0

# کلید رمزنگاری گاوصندوق AES-256-GCM سمت سرور
BIT24_PRO_VAULT_SECRET=change-this-to-a-strong-random-32char-secret

# کلیدهای رسمی API صرافی بیت۲۴ (فقط دسترسی خواندن و معامله اسپات — هرگز دسترسی برداشت فعال نشود!)
